<Window x:Class="ITAD.LibrarySync.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Lang[SettingsTitle], Mode=OneWay}"
        Height="560"
        Width="760"
        MinHeight="440"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- 1. ITAD CONNECTION TAB -->
            <TabItem Header="{Binding Lang[TabItad], Mode=OneWay}">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding Lang[ItadHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                    
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Lang[ConnectionStatusLabel], Mode=OneWay}" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" Foreground="#0284C7"
                                           Text="{Binding ConnectionStatusText, Mode=OneWay}" VerticalAlignment="Center" />
                            </Grid>
                            
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Lang[UsernameLabel], Mode=OneWay}" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" Foreground="#0F172A"
                                           Text="{Binding AccountName, Mode=OneWay}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <Button Content="{Binding Lang[ConnectBtn], Mode=OneWay}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="130"
                                Margin="0,0,8,0"
                                Command="{Binding ConnectCommand}" />
                        <Button Content="{Binding Lang[DisconnectBtn], Mode=OneWay}"
                                Width="130"
                                Command="{Binding DisconnectCommand}" />
                        <Button Content="{Binding Lang[SyncNowBtn], Mode=OneWay}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="160"
                                Margin="12,0,0,0"
                                Command="{Binding SyncNowCommand}" />
                    </StackPanel>

                    <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Foreground="#0369A1" TextWrapping="Wrap" FontSize="12" LineHeight="17">
                                <Run FontWeight="Bold" Text="{Binding Lang[ItadHowItWorksTitle], Mode=OneWay}" /><LineBreak />
                                <Run Text="{Binding Lang[ItadHowItWorksText], Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- 2. PLATFORMS TAB -->
            <TabItem Header="{Binding Lang[TabPlatforms], Mode=OneWay}">
                <DockPanel Margin="4">
                    <!-- Platform Scanning Info Card -->
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock Foreground="#334155" TextWrapping="Wrap" FontSize="11.5" LineHeight="16">
                                <Run FontWeight="Bold" Text="{Binding Lang[PlatformTipsTitle], Mode=OneWay}" /><LineBreak />
                                <Run Text="{Binding Lang[PlatformTipsText], Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DataGrid DockPanel.Dock="Top"
                               Margin="0,0,0,12"
                               ItemsSource="{Binding LauncherStatuses}"
                               AutoGenerateColumns="False"
                               CanUserAddRows="False"
                               CanUserDeleteRows="False"
                               HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding DataContext.Lang[ColPlatform], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Binding="{Binding DisplayName}"
                                                Width="*"
                                                IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="{Binding DataContext.Lang[ColEnabled], RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                   Width="65" />
                            <DataGridTextColumn Header="{Binding DataContext.Lang[ColStatus], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Binding="{Binding DetectionStatus}"
                                                Width="110"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="{Binding DataContext.Lang[ColLastSync], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Binding="{Binding LastSyncStats}"
                                                Width="*"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="{Binding DataContext.Lang[ColResult], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Binding="{Binding LastReadResult}"
                                                Width="*"
                                                IsReadOnly="True" />
                            <DataGridTemplateColumn Header="{Binding DataContext.Lang[ColTest], RelativeSource={RelativeSource AncestorType=Window}}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DataContext.Lang[BtnTest], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="6,2"
                                                ToolTip="{Binding DataContext.Lang[TestBtnTooltip], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.TestReadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{Binding DataContext.Lang[ColDetails], RelativeSource={RelativeSource AncestorType=Window}}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DataContext.Lang[BtnDetails], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="6,2"
                                                ToolTip="{Binding DataContext.Lang[DetailsBtnTooltip], RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,0,4,8">
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Lang[XboxAccountHeader], Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding XboxConnectionStatus, Mode=OneWay}" Foreground="#64748B" Margin="0,2,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Lang[BtnConnectXbox], Mode=OneWay}" Command="{Binding ConnectXboxCommand}" Margin="0,0,8,0"/>
                                        <Button Content="{Binding Lang[BtnDisconnectXbox], Mode=OneWay}" Command="{Binding DisconnectXboxCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 3. SYNCHRONIZATION TAB -->
            <TabItem Header="{Binding Lang[TabSync], Mode=OneWay}">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding Lang[SyncSettingsHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                    
                    <!-- Sync Guide Banner -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock Foreground="#475569" TextWrapping="Wrap" FontSize="12" LineHeight="17">
                                <Run FontWeight="Bold" Text="{Binding Lang[SyncGuideTitle], Mode=OneWay}" /><LineBreak />
                                <Run Text="{Binding Lang[SyncGuideText], Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,4,0,6" Text="{Binding Lang[SyncIntervalLabel], Mode=OneWay}" Foreground="#64748B" FontSize="13" />
                    <ComboBox Width="240"
                              HorizontalAlignment="Left"
                              ToolTip="{Binding Lang[SyncIntervalTooltip], Mode=OneWay}"
                              ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding SelectedInterval}" />

                    <CheckBox Margin="0,18,0,0"
                              Content="{Binding Lang[SyncOnStartupLabel], Mode=OneWay}"
                              ToolTip="{Binding Lang[SyncOnStartupTooltip], Mode=OneWay}"
                              IsChecked="{Binding SyncOnStartup}" />

                    <CheckBox Margin="0,10,0,0"
                              Content="{Binding Lang[ConfirmBeforeSyncLabel], Mode=OneWay}"
                              ToolTip="{Binding Lang[ConfirmBeforeSyncTooltip], Mode=OneWay}"
                              IsChecked="{Binding ConfirmBeforeSync}" />
                </StackPanel>
            </TabItem>

            <!-- 4. STATISTICS TAB -->
            <TabItem Header="{Binding Lang[TabStats], Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="{Binding Lang[StatsHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                        <UniformGrid Columns="3" Margin="0,16,0,16">
                            <Border Background="#1A0284C7" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Lang[TotalSyncedGamesLabel], Mode=OneWay}" Foreground="#0369A1" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TotalSyncedGamesCount}" FontSize="26" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1A107C41" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Lang[MatchRateLabel], Mode=OneWay}" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MatchRatePercentage, StringFormat=\{0\}%}" FontSize="26" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1A5C2D91" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Lang[ActivePlatformsLabel], Mode=OneWay}" Foreground="#7E22CE" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding EnabledLaunchersCount}" FontSize="26" FontWeight="Bold" Foreground="#9333EA" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="{Binding Lang[CustomMappingsHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,8" />
                        <DataGrid ItemsSource="{Binding CustomMappings}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="180"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding DataContext.Lang[ColPlatform], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Launcher}" Width="95" />
                                <DataGridTextColumn Header="{Binding DataContext.Lang[ColGameTitle], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="{Binding DataContext.Lang[ColLocalStoreId], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding StoreId}" Width="130" />
                                <DataGridTextColumn Header="{Binding DataContext.Lang[ColTargetItadId], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding MappedId}" Width="140" />
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DataContext.Lang[BtnDelete], RelativeSource={RelativeSource AncestorType=Window}}" Padding="6,2"
                                                    ToolTip="{Binding DataContext.Lang[DeleteMappingTooltip], RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.RemoveCustomMappingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5. UNMATCHED GAMES TAB -->
            <TabItem Header="{Binding Lang[TabUnmatched], Mode=OneWay}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FEFCE8" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛠️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock Foreground="#854D0E" TextWrapping="Wrap" FontSize="11.5" LineHeight="16">
                                <Run FontWeight="Bold" Text="{Binding Lang[UnmatchedGuideTitle], Mode=OneWay}" /><LineBreak />
                                <Run Text="{Binding Lang[UnmatchedGuideText], Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="{Binding Lang[BtnClearList], Mode=OneWay}"
                                Padding="12,4"
                                Margin="8,0,0,0"
                                ToolTip="{Binding Lang[ClearListTooltip], Mode=OneWay}"
                                Command="{Binding ClearUnmatchedTitlesCommand}" />
                        <Button DockPanel.Dock="Right"
                                Content="{Binding Lang[BtnRefresh], Mode=OneWay}"
                                Padding="12,4"
                                ToolTip="{Binding Lang[RefreshListTooltip], Mode=OneWay}"
                                Command="{Binding LoadUnmatchedTitlesCommand}" />
                        <TextBox Text="{Binding UnmatchedSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="6,4" />
                    </DockPanel>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding FilteredUnmatchedTitles}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding DataContext.Lang[ColPlatform], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Launcher}" Width="90" />
                            <DataGridTextColumn Header="{Binding DataContext.Lang[ColGameTitle], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="{Binding DataContext.Lang[ColLocalStoreId], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding StoreId}" Width="120" />
                            <DataGridTextColumn Header="{Binding DataContext.Lang[ColReason], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Reason}" Width="1.2*" />
                            <DataGridTextColumn Header="{Binding DataContext.Lang[ColDate], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding DetectedAt, StringFormat=\{0:g\}}" Width="110" />
                            <DataGridTemplateColumn Header="{Binding DataContext.Lang[ColAction], RelativeSource={RelativeSource AncestorType=Window}}" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DataContext.Lang[BtnFix], RelativeSource={RelativeSource AncestorType=Window}}" Padding="6,2"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding DataContext.FixMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 6. LOGS TAB -->
            <TabItem Header="{Binding Lang[TabLogs], Mode=OneWay}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Text="{Binding Lang[LogsGuideText], Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="{Binding Lang[BtnOpenLogFolder], Mode=OneWay}"
                                Padding="12,4"
                                Margin="8,0,0,0"
                                ToolTip="{Binding Lang[OpenLogFolderTooltip], Mode=OneWay}"
                                Command="{Binding OpenLogFolderCommand}" />
                        <Button DockPanel.Dock="Right"
                                Content="{Binding Lang[BtnRefresh], Mode=OneWay}"
                                Padding="12,4"
                                Margin="8,0,0,0"
                                ToolTip="{Binding Lang[RefreshLogsTooltip], Mode=OneWay}"
                                Command="{Binding RefreshLogsCommand}" />
                        <ComboBox DockPanel.Dock="Right"
                                  Width="100"
                                  Margin="8,0,0,0"
                                  ToolTip="{Binding Lang[LogFilterTooltip], Mode=OneWay}"
                                  ItemsSource="{Binding LogFilterOptions}"
                                  SelectedItem="{Binding SelectedLogFilter}" />
                        <TextBox Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="6,4" />
                    </DockPanel>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding FilteredLogs}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding DataContext.Lang[ColTime], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Timestamp, StringFormat=\{0:HH:mm:ss\}}" Width="85" />
                            <DataGridTextColumn Header="{Binding DataContext.Lang[ColLevel], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Level}" Width="75" />
                            <DataGridTextColumn Header="{Binding DataContext.Lang[ColMessage], RelativeSource={RelativeSource AncestorType=Window}}" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 7. GENERAL TAB -->
            <TabItem Header="{Binding Lang[TabGeneral], Mode=OneWay}">
                <StackPanel Margin="16">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ITAD Library Sync" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Lang[AppSubtitle], Mode=OneWay}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0284C7" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayVersionText, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding Lang[AppPreferencesHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                    <CheckBox Margin="0,12,0,0"
                              Content="{Binding Lang[StartWithWindowsLabel], Mode=OneWay}"
                              ToolTip="{Binding Lang[StartWithWindowsTooltip], Mode=OneWay}"
                              IsChecked="{Binding StartWithWindows}" />
                    <CheckBox Margin="0,10,0,0"
                              Content="{Binding Lang[ShowNotificationsLabel], Mode=OneWay}"
                              ToolTip="{Binding Lang[ShowNotificationsTooltip], Mode=OneWay}"
                              IsChecked="{Binding ShowNotifications}" />

                    <TextBlock Margin="0,14,0,6" Text="{Binding Lang[LanguageLabel], Mode=OneWay}" Foreground="#64748B" FontSize="13" />
                    <ComboBox Width="220"
                              HorizontalAlignment="Left"
                              ToolTip="{Binding Lang[LanguageTooltip], Mode=OneWay}"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}" />

                    <TextBlock Margin="0,14,0,6" Text="{Binding Lang[LogLevelLabel], Mode=OneWay}" Foreground="#64748B" FontSize="13" />
                    <ComboBox Width="220"
                              HorizontalAlignment="Left"
                              ToolTip="{Binding Lang[LogLevelTooltip], Mode=OneWay}"
                              ItemsSource="{Binding LogLevelOptions}"
                              SelectedItem="{Binding SelectedLogLevel}" />

                    <Separator Margin="0,20,0,16" Background="#E2E8F0" />

                    <TextBlock Text="{Binding Lang[AppUpdatesHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Margin="0,6,0,0" FontSize="13" Text="{Binding DisplayCurrentVersionText, Mode=OneWay}" />
                    <TextBlock Margin="0,4,0,12" Foreground="#64748B" Text="{Binding UpdateStatusText, Mode=OneWay}" TextWrapping="Wrap" />

                    <ProgressBar Margin="0,0,0,12" Height="8" Value="{Binding DownloadProgress, Mode=OneWay}"
                                 Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Lang[BtnCheckUpdates], Mode=OneWay}"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Command="{Binding CheckForUpdatesCommand}"
                                IsEnabled="{Binding CanCheckUpdates}" />
                        <Button Content="{Binding Lang[BtnDownloadUpdate], Mode=OneWay}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,6"
                                Command="{Binding DownloadAndApplyUpdateCommand}"
                                IsEnabled="{Binding CanCheckUpdates}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Width="90"
                Content="{Binding Lang[BtnClose], Mode=OneWay}"
                IsDefault="True"
                Click="CloseButton_Click" />
    </Grid>
</Window>
