<Window x:Class="ITAD.LibrarySync.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ITAD.LibrarySync.App.Converters"
        xmlns:services="clr-namespace:ITAD.LibrarySync.App.Services"
        Title="{Binding Lang[SettingsTitle], Mode=OneWay}"
        Height="680"
        Width="860"
        MinHeight="540"
        MinWidth="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <converters:UnmatchedReasonConverter x:Key="UnmatchedReasonConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- ============================================================ -->
            <!-- 1. ACCOUNTS & PLATFORMS TAB -->
            <!-- ============================================================ -->
            <TabItem Header="{Binding Lang[TabAccountsAndPlatforms], Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <!-- Quick guide -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Lang[PlatformsGuide], Mode=OneWay}"
                                       FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap" LineHeight="17" />
                        </Border>

                        <!-- Enhanced Statistics Summary Panel -->
                        <TextBlock Text="{Binding Lang[StatsHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        
                        <!-- 4 Summary Cards Grid (Clickable) -->
                        <UniformGrid Columns="4" Margin="-4,0,-4,12">
                            <Border Style="{StaticResource InteractiveCardStyle}" Background="#1A0284C7" BorderBrush="#BAE6FD" BorderThickness="1" ToolTip="{Binding Lang[StatCardClickTooltip], Mode=OneWay}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ViewStatDetailsCommand}" CommandParameter="TotalGames" />
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Text="{Binding Lang[TotalSyncedGamesLabel], Mode=OneWay}" Foreground="#0369A1" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TotalSyncedGamesCount}" FontSize="22" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InteractiveCardStyle}" Background="#1A107C41" BorderBrush="#BBF7D0" BorderThickness="1" ToolTip="{Binding Lang[StatCardClickTooltip], Mode=OneWay}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ViewStatDetailsCommand}" CommandParameter="MatchRate" />
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Text="{Binding Lang[MatchRateLabel], Mode=OneWay}" Foreground="#15803D" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MatchRatePercentage, StringFormat=\{0\}%}" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InteractiveCardStyle}" Background="#1A5C2D91" BorderBrush="#E9D5FF" BorderThickness="1" ToolTip="{Binding Lang[StatCardClickTooltip], Mode=OneWay}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ViewStatDetailsCommand}" CommandParameter="ActivePlatforms" />
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Text="{Binding Lang[ActivePlatformsLabel], Mode=OneWay}" Foreground="#7E22CE" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding EnabledLaunchersCount}" FontSize="22" FontWeight="Bold" Foreground="#9333EA" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InteractiveCardStyle}" Background="#1AEA580C" BorderBrush="#FFEDD5" BorderThickness="1" ToolTip="{Binding Lang[StatCardClickTooltip], Mode=OneWay}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ViewStatDetailsCommand}" CommandParameter="DuplicateGames" />
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Text="{Binding Lang[DuplicateGamesLabel], Mode=OneWay}" Foreground="#C2410C" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DuplicateGamesCount}" FontSize="22" FontWeight="Bold" Foreground="#EA580C" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Smart Insights & Platform Distribution Section -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Smart Breakdown Stats -->
                                <TextBlock Text="{Binding Lang[SmartInsightsHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,8" />
                                <UniformGrid Columns="3" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="🟢 " FontSize="12" />
                                        <TextBlock Text="{Binding Lang[AutoMatchedLabel], Mode=OneWay}" Foreground="#475569" FontSize="12" />
                                        <TextBlock Text=": " Foreground="#475569" FontSize="12" />
                                        <TextBlock Text="{Binding AutomaticallyMatchedCount}" FontWeight="Bold" Foreground="#15803D" FontSize="12" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="🔵 " FontSize="12" />
                                        <TextBlock Text="{Binding Lang[CustomMappedLabel], Mode=OneWay}" Foreground="#475569" FontSize="12" />
                                        <TextBlock Text=": " Foreground="#475569" FontSize="12" />
                                        <TextBlock Text="{Binding CustomMappedCount}" FontWeight="Bold" Foreground="#0369A1" FontSize="12" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="🟡 " FontSize="12" />
                                        <TextBlock Text="{Binding Lang[UnmatchedCountLabel], Mode=OneWay}" Foreground="#475569" FontSize="12" />
                                        <TextBlock Text=": " Foreground="#475569" FontSize="12" />
                                        <TextBlock Text="{Binding UnmatchedCount}" FontWeight="Bold" Foreground="#B45309" FontSize="12" />
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Platform Library Distribution Bars -->
                                <TextBlock Text="{Binding Lang[PlatformDistributionHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding PlatformStats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium" Foreground="#1E293B" VerticalAlignment="Center" />

                                                <ProgressBar Grid.Column="1" Value="{Binding Percentage}" Maximum="100" Height="8" VerticalAlignment="Center" Margin="8,0" Background="#E2E8F0" BorderThickness="0" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GameCount}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                                                    <TextBlock Text=" (" FontSize="11" Foreground="#64748B" />
                                                    <TextBlock Text="{Binding Percentage, StringFormat=\{0\}%}" FontSize="11" Foreground="#64748B" />
                                                    <TextBlock Text=")" FontSize="11" Foreground="#64748B" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ITAD Account Card -->
                        <TextBlock Text="{Binding Lang[ItadHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                        
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Lang[ConnectionStatusLabel], Mode=OneWay}" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" Foreground="#0284C7"
                                               Text="{Binding ConnectionStatusText, Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                                
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Lang[UsernameLabel], Mode=OneWay}" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" Foreground="#0F172A"
                                               Text="{Binding AccountName, Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                            <Button Content="{Binding Lang[ConnectBtn], Mode=OneWay}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="120"
                                    Margin="0,0,8,0"
                                    Command="{Binding ConnectCommand}" />
                            <Button Content="{Binding Lang[DisconnectBtn], Mode=OneWay}"
                                    MinWidth="120"
                                    Margin="0,0,12,0"
                                    Command="{Binding DisconnectCommand}" />
                            <Button Content="{Binding Lang[SyncNowBtn], Mode=OneWay}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="150"
                                    Command="{Binding SyncNowCommand}" />
                        </StackPanel>

                        <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💡" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <TextBlock Foreground="#0369A1" TextWrapping="Wrap" FontSize="12" LineHeight="17">
                                    <Run FontWeight="Bold" Text="{Binding Lang[ItadHowItWorksTitle], Mode=OneWay}" /><LineBreak />
                                    <Run Text="{Binding Lang[ItadHowItWorksText], Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Platform Launchers & Connected Accounts Section -->
                        <TextBlock Text="{Binding Lang[PlatformsHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,0" />
                        
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top" />
                                <TextBlock Foreground="#475569" TextWrapping="Wrap" FontSize="12" LineHeight="17">
                                    <Run FontWeight="Bold" Text="{Binding Lang[PlatformScanInfoTitle], Mode=OneWay}" /><LineBreak />
                                    <Run Text="{Binding Lang[PlatformScanInfoText], Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding LauncherStatuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,14,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding DetectionStatus}" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="{Binding DataContext.Lang[BtnDetails], RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center" MinWidth="85" MinHeight="32" Padding="12,5" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Launcher Account Connections (Xbox & EA App) -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Lang[XboxAccountHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="{Binding XboxConnectionStatus, Mode=OneWay}" Foreground="#64748B" FontSize="12" Margin="0,3,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Lang[BtnConnectXbox], Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConnectXboxCommand}" MinWidth="110" Margin="0,0,8,0"/>
                                        <Button Content="{Binding Lang[BtnDisconnectXbox], Mode=OneWay}" Command="{Binding DisconnectXboxCommand}" MinWidth="110"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Lang[EaAccountHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="{Binding EaConnectionStatus, Mode=OneWay}" Foreground="#64748B" FontSize="12" Margin="0,3,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Lang[BtnConnectEa], Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConnectEaCommand}" MinWidth="110" Margin="0,0,8,0"/>
                                        <Button Content="{Binding Lang[BtnDisconnectEa], Mode=OneWay}" Command="{Binding DisconnectEaCommand}" MinWidth="110"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ -->
            <!-- 2. SYNC & MATCHING TAB -->
            <!-- ============================================================ -->
            <TabItem Header="{Binding Lang[TabSyncAndMappings], Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Quick guide -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Lang[SyncMappingsGuide], Mode=OneWay}"
                                       FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap" LineHeight="17" />
                        </Border>
                        <!-- Inline Sync Progress Card -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right"
                                            Content="{Binding Lang[SyncNowBtn], Mode=OneWay}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="14,6"
                                            Command="{Binding SyncNowCommand}" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔄" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Lang[SyncInlineHeader], Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="{Binding SyncProgress.StatusText}"
                                           FontSize="12.5" Foreground="#475569" FontWeight="Medium" Margin="0,2,0,6" />

                                <ProgressBar Height="6" Margin="0,4,0,10"
                                             IsIndeterminate="{Binding SyncProgress.IsSyncing}"
                                             Visibility="{Binding SyncProgress.IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />

                                <ListBox x:Name="SyncInlineLogList"
                                         ItemsSource="{Binding SyncProgress.Lines}"
                                         MaxHeight="140" MinHeight="65"
                                         FontFamily="Consolas" FontSize="11.5"
                                         Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                         Padding="6"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <!-- Unmatched Games Section -->
                        <TextBlock Text="{Binding Lang[UnmatchedGuideTitle], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" />
                        
                        <Border Background="#FEFCE8" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,6,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top" />
                                <TextBlock Foreground="#713F12" TextWrapping="Wrap" FontSize="11.5" LineHeight="16"
                                           Text="{Binding Lang[UnmatchedGuideText], Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Toolbar & Search Box -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Text="{Binding UnmatchedSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding Lang[SearchUnmatchedTooltip], Mode=OneWay}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding Lang[BtnRefresh], Mode=OneWay}"
                                        Command="{Binding LoadUnmatchedTitlesCommand}"
                                        MinWidth="90" MinHeight="34" Margin="0,0,6,0" Padding="12,6" />
                                <Button Content="{Binding Lang[BtnClearList], Mode=OneWay}"
                                        Command="{Binding ClearUnmatchedTitlesCommand}"
                                        MinWidth="90" MinHeight="34" Padding="12,6" />
                            </StackPanel>
                        </Grid>

                        <DataGrid ItemsSource="{Binding FilteredUnmatchedTitles}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="220"
                                  HeadersVisibility="Column"
                                  Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColPlatform], Mode=OneWay}" Binding="{Binding Launcher}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColGameTitle], Mode=OneWay}" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColLocalStoreId], Mode=OneWay}" Binding="{Binding StoreId}" Width="1.2*" />
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColReason], Mode=OneWay}" Binding="{Binding ReasonCode, Converter={StaticResource UnmatchedReasonConverter}}" Width="1.5*" />
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColAction], Mode=OneWay}" Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DataContext.Lang[BtnFix], RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    MinHeight="28" MinWidth="85" Padding="10,4"
                                                    Command="{Binding DataContext.FixMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Custom Game Mappings Section -->
                        <TextBlock Text="{Binding Lang[CustomMappingsHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" />
                        
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,6,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✉️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top" />
                                <TextBlock Foreground="#166534" TextWrapping="Wrap" FontSize="11.5" LineHeight="16"
                                           Text="{Binding Lang[CustomMappingsGuideText], Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <DataGrid ItemsSource="{Binding CustomMappings}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="180"
                                  HeadersVisibility="Column"
                                  Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColPlatform], Mode=OneWay}" Binding="{Binding Launcher}" Width="100" />
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColGameTitle], Mode=OneWay}" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColLocalStoreId], Mode=OneWay}" Binding="{Binding StoreId}" Width="1.2*" />
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColTargetItadId], Mode=OneWay}" Binding="{Binding MappedId}" Width="1.4*" />
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColAction], Mode=OneWay}" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" MinWidth="32" MinHeight="26" Padding="6,2" FontWeight="Bold" Foreground="#DC2626" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                    ToolTip="{Binding DataContext.Lang[DeleteMappingTooltip], RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.RemoveCustomMappingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button HorizontalAlignment="Right"
                                Content="{Binding Lang[BtnSyncCustomMappings], Mode=OneWay}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="160" MinHeight="36" Padding="16,8"
                                ToolTip="{Binding Lang[SyncCustomMappingsTooltip], Mode=OneWay}"
                                Command="{Binding SyncCustomMappingsCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ -->
            <!-- 3. SETTINGS & LOGS TAB -->
            <!-- ============================================================ -->
            <TabItem Header="{Binding Lang[TabCloudSaves], Mode=OneWay}">
                <ScrollViewer DataContext="{Binding CloudSaves}"
                              VerticalScrollBarVisibility="Auto"
                              Padding="16">
                    <StackPanel>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Lang[CloudSavesIntro], Mode=OneWay}"
                                       FontSize="12" Foreground="#166534" TextWrapping="Wrap" LineHeight="17" />
                        </Border>

                        <!-- STEP 1: choose cloud -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="#0284C7" CornerRadius="4" Width="22" Height="22">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Lang[CloudStep1Title], Mode=OneWay}"
                                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Lang[CloudStep1Hint], Mode=OneWay}"
                                           FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding Providers}"
                                              SelectedItem="{Binding SelectedProvider}"
                                              Width="280" HorizontalAlignment="Left"
                                              IsEnabled="{Binding CanDetect}" />
                                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                               FontSize="12" Foreground="#64748B">
                                        <Run Text="{Binding Lang[CloudProviderRootLabel], Mode=OneWay}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding SelectedProvider.Root, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <CheckBox Content="{Binding Lang[CloudLiveLookupLabel], Mode=OneWay}"
                                          IsChecked="{Binding UsePcgwLookup}"
                                          ToolTip="{Binding Lang[CloudLiveLookupTooltip], Mode=OneWay}"
                                          Margin="0,10,0,0" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <!-- STEP 2: pick games -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="#0284C7" CornerRadius="4" Width="22" Height="22">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Lang[CloudStep2Title], Mode=OneWay}"
                                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Lang[CloudStep2Hint], Mode=OneWay}"
                                           FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="{Binding Lang[BtnCloudDetect], Mode=OneWay}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding DetectGamesCommand}"
                                            IsEnabled="{Binding CanDetect}"
                                            MinHeight="34" Padding="12,6" />
                                    <Button Content="{Binding Lang[BtnCloudSelectAll], Mode=OneWay}"
                                            Command="{Binding SelectAllCommand}"
                                            Margin="8,0,0,0" MinHeight="34" Padding="12,6" />
                                    <Button Content="{Binding Lang[BtnCloudSelectNone], Mode=OneWay}"
                                            Command="{Binding SelectNoneCommand}"
                                            Margin="8,0,0,0" MinHeight="34" Padding="12,6" />
                                    <Button Content="{Binding Lang[BtnCloudLookupSelected], Mode=OneWay}"
                                            Command="{Binding LookupSelectedCommand}"
                                            IsEnabled="{Binding CanLookupSelected}"
                                            ToolTip="{Binding Lang[BtnCloudLookupSelectedTooltip], Mode=OneWay}"
                                            Margin="8,0,0,0" MinHeight="34" Padding="12,6" />
                                </StackPanel>

                                <DataGrid ItemsSource="{Binding Games}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False" CanUserSortColumns="True"
                                          IsReadOnly="False" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          MaxHeight="260" MinHeight="100"
                                          SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColCloudSelect], Mode=OneWay}" Binding="{Binding IsSelected}" Width="50" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColCloudTitle], Mode=OneWay}" Binding="{Binding Title}" Width="1.4*" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColCloudPlatform], Mode=OneWay}" Binding="{Binding Platform}" Width="100" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColCloudSource], Mode=OneWay}" Binding="{Binding SourcePath}" Width="1.7*" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColCloudStatus], Mode=OneWay}" Binding="{Binding StatusText}" Width="1.1*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding StatusColor}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColCloudAction], Mode=OneWay}" Width="125">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding DataContext.Lang[BtnCloudSetFolder], RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Command="{Binding DataContext.CloudSetSaveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanSetFolder}"
                                                            ToolTip="{Binding DataContext.Lang[BtnCloudSetFolderTooltip], RelativeSource={RelativeSource AncestorType=Window}}"
                                                            MinHeight="28" MinWidth="85" Padding="10,4" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- STEP 3: move & manage -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="#16A34A" CornerRadius="4" Width="22" Height="22">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Lang[CloudStep3Title], Mode=OneWay}"
                                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Lang[CloudStep3Hint], Mode=OneWay}"
                                           FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10" />

                                <Button Content="{Binding Lang[BtnCloudMigrate], Mode=OneWay}"
                                        Command="{Binding MigrateCommand}"
                                        IsEnabled="{Binding CanMigrate}"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12" Padding="16,8" MinHeight="36" MinWidth="140"
                                        Background="#16A34A" Foreground="White" BorderThickness="0"
                                        FontWeight="SemiBold">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <DataGrid ItemsSource="{Binding Mappings}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False" CanUserSortColumns="True"
                                          IsReadOnly="True" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          MaxHeight="200" MinHeight="70"
                                          SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColCloudTitle], Mode=OneWay}" Binding="{Binding Title}" Width="1.2*" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColCloudSource], Mode=OneWay}" Binding="{Binding SourcePath}" Width="1.5*" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColCloudTarget], Mode=OneWay}" Binding="{Binding TargetPath}" Width="1.5*" />
                                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColCloudCreated], Mode=OneWay}" Binding="{Binding CreatedDisplay}" Width="110" />
                                        <DataGridTemplateColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColCloudAction], Mode=OneWay}" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="{Binding DataContext.Lang[BtnCloudRestore], RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Command="{Binding DataContext.CloudRestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                MinHeight="26" Padding="8,3" Margin="0,0,6,0" />
                                                        <Button Content="✕" MinWidth="28" MinHeight="26" Padding="6,2" FontWeight="Bold" Foreground="#DC2626" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                                Command="{Binding DataContext.CloudRemoveMappingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Status line -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                            <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                       FontSize="12" Foreground="#334155" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{Binding Lang[TabSettingsAndLogs], Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Quick guide -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Lang[SettingsGuide], Mode=OneWay}"
                                       FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap" LineHeight="17" />
                        </Border>
                        <!-- Synchronization Configuration -->
                        <TextBlock Text="{Binding Lang[SyncSettingsHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                        
                        <TextBlock Margin="0,8,0,6" Text="{Binding Lang[SyncIntervalLabel], Mode=OneWay}" Foreground="#64748B" FontSize="13" />
                        <ComboBox Width="240"
                                  HorizontalAlignment="Left"
                                  ToolTip="{Binding Lang[SyncIntervalTooltip], Mode=OneWay}"
                                  ItemsSource="{Binding IntervalOptions}"
                                  SelectedItem="{Binding SelectedIntervalOption}"
                                  DisplayMemberPath="DisplayName" />

                        <CheckBox Margin="0,14,0,0"
                                  Content="{Binding Lang[SyncOnStartupLabel], Mode=OneWay}"
                                  ToolTip="{Binding Lang[SyncOnStartupTooltip], Mode=OneWay}"
                                  IsChecked="{Binding SyncOnStartup}" />

                        <CheckBox Margin="0,10,0,0"
                                  Content="{Binding Lang[ConfirmBeforeSyncLabel], Mode=OneWay}"
                                  ToolTip="{Binding Lang[ConfirmBeforeSyncTooltip], Mode=OneWay}"
                                  IsChecked="{Binding ConfirmBeforeSync}" />

                        <Separator Margin="0,16,0,14" Background="#E2E8F0" />

                        <!-- Application Preferences -->
                        <TextBlock Text="{Binding Lang[AppPreferencesHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                        
                        <CheckBox Margin="0,10,0,0"
                                  Content="{Binding Lang[StartWithWindowsLabel], Mode=OneWay}"
                                  ToolTip="{Binding Lang[StartWithWindowsTooltip], Mode=OneWay}"
                                  IsChecked="{Binding StartWithWindows}" />

                        <CheckBox Margin="0,10,0,0"
                                  Content="{Binding Lang[CloseToTrayLabel], Mode=OneWay}"
                                  ToolTip="{Binding Lang[CloseToTrayTooltip], Mode=OneWay}"
                                  IsChecked="{Binding MinimizeToTray}" />

                        <CheckBox Margin="0,10,0,0"
                                  Content="{Binding Lang[ShowNotificationsLabel], Mode=OneWay}"
                                  ToolTip="{Binding Lang[ShowNotificationsTooltip], Mode=OneWay}"
                                  IsChecked="{Binding ShowNotifications}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Lang[LanguageLabel], Mode=OneWay}" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
                                <ComboBox Width="200"
                                          HorizontalAlignment="Left"
                                          ToolTip="{Binding Lang[LanguageTooltip], Mode=OneWay}"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguage}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Lang[LogLevelLabel], Mode=OneWay}" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
                                <ComboBox Width="200"
                                          HorizontalAlignment="Left"
                                          ToolTip="{Binding Lang[LogLevelTooltip], Mode=OneWay}"
                                          ItemsSource="{Binding LogLevelOptions}"
                                          SelectedItem="{Binding SelectedLogLevelOption}"
                                          DisplayMemberPath="DisplayName" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,16,0,14" Background="#E2E8F0" />

                        <!-- System Logs Viewer -->
                        <TextBlock Text="{Binding Lang[SystemLogsHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                        
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding Lang[SearchLogsTooltip], Mode=OneWay}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding Lang[BtnOpenLogFolder], Mode=OneWay}"
                                        Command="{Binding OpenLogFolderCommand}"
                                        MinWidth="110" MinHeight="34" Margin="0,0,6,0" Padding="12,6" />
                                <Button Content="{Binding Lang[BtnRefresh], Mode=OneWay}"
                                        Command="{Binding RefreshLogsCommand}"
                                        MinWidth="90" MinHeight="34" Padding="12,6" />
                            </StackPanel>
                        </Grid>

                        <DataGrid ItemsSource="{Binding FilteredLogs}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="180"
                                  HeadersVisibility="Column"
                                  Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColTime], Mode=OneWay}" Binding="{Binding TimestampDisplay}" Width="80" />
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColLevel], Mode=OneWay}" Binding="{Binding Level}" Width="70" />
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColMessage], Mode=OneWay}" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Separator Margin="0,0,0,14" Background="#E2E8F0" />

                        <!-- Application Updates -->
                        <TextBlock Text="{Binding Lang[AppUpdatesHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Margin="0,4,0,0" FontSize="13" Text="{Binding DisplayCurrentVersionText, Mode=OneWay}" />
                        <TextBlock Margin="0,2,0,8" Foreground="#64748B" Text="{Binding UpdateStatusText, Mode=OneWay}" TextWrapping="Wrap" />

                        <ProgressBar Margin="0,0,0,10" Height="8" Value="{Binding DownloadProgress, Mode=OneWay}"
                                     Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Lang[BtnCheckUpdates], Mode=OneWay}"
                                    MinWidth="130" MinHeight="36" Padding="14,7"
                                    Margin="0,0,8,0"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    IsEnabled="{Binding CanCheckUpdates}" />
                            <Button Content="{Binding Lang[BtnDownloadUpdate], Mode=OneWay}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="130" MinHeight="36" Padding="14,7"
                                    Command="{Binding DownloadAndApplyUpdateCommand}"
                                    IsEnabled="{Binding CanCheckUpdates}"
                                    Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                        </StackPanel>

                        <Separator Margin="0,16,0,14" Background="#E2E8F0" />

                        <!-- Patreon Support Card -->
                        <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="❤️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Lang[PatreonHeader], Mode=OneWay}"
                                                   FontWeight="Bold" FontSize="14" Foreground="#9F1239" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Lang[PatreonDesc], Mode=OneWay}"
                                               FontSize="12" Foreground="#881337" TextWrapping="Wrap" LineHeight="16" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{Binding Lang[BtnPatreonSupport], Mode=OneWay}"
                                        Command="{Binding OpenPatreonCommand}"
                                        Background="#FF424D" Foreground="White"
                                        FontWeight="SemiBold" FontSize="13"
                                        MinHeight="36" Padding="16,8" BorderThickness="0"
                                        Cursor="Hand"
                                        VerticalAlignment="Center">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            
        </TabControl>

        <Button Grid.Row="1"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                MinWidth="100" MinHeight="36" Padding="16,8"
                Content="{Binding Lang[BtnClose], Mode=OneWay}"
                IsDefault="True"
                Click="CloseButton_Click" />
    </Grid>
</Window>
