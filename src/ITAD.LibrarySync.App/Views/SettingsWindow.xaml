<Window x:Class="ITAD.LibrarySync.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ITAD Library Sync — Settings"
        Height="520"
        Width="720"
        MinHeight="420"
        MinWidth="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="ITAD Connection">
                <StackPanel Margin="12">
                    <TextBlock Text="IsThereAnyDeal Account" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Margin="0,12,0,4" Text="Status" Foreground="Gray" />
                    <TextBlock FontSize="13"
                               Text="{Binding ConnectionStatus, Mode=OneWay, StringFormat=Connection: {0}}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="13"
                               Text="{Binding AccountName, Mode=OneWay, StringFormat=Account: {0}}" />

                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <Button Content="Connect"
                                Width="100"
                                Margin="0,0,8,0"
                                Command="{Binding ConnectCommand}" />
                        <Button Content="Disconnect"
                                Width="100"
                                Command="{Binding DisconnectCommand}" />
                        <Button Content="Sync Now"
                                Width="100"
                                Margin="8,0,0,0"
                                Command="{Binding SyncNowCommand}" />
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Text="Connect your ITAD account to sync your game libraries to Collection and Waitlist profiles." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Launchers">
                <DockPanel>
                    <DataGrid DockPanel.Dock="Top"
                              Margin="8"
                              ItemsSource="{Binding LauncherStatuses}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Launcher"
                                                Binding="{Binding DisplayName}"
                                                Width="*"
                                                IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="Enabled"
                                                   Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                   Width="70" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding DetectionStatus}"
                                                Width="100"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Last Sync"
                                                Binding="{Binding LastSyncStats}"
                                                Width="*"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Read Result"
                                                Binding="{Binding LastReadResult}"
                                                Width="*"
                                                IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Test Read" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Test"
                                                Padding="8,2"
                                                Command="{Binding DataContext.TestReadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Detay" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Detay"
                                                Padding="8,2"
                                                Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Margin="8,0,8,8">
                        <TextBlock Text="Xbox / Microsoft Store account" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding XboxConnectionStatus, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Connect Xbox" Command="{Binding ConnectXboxCommand}" Margin="0,0,8,0"/>
                            <Button Content="Disconnect Xbox" Command="{Binding DisconnectXboxCommand}"/>
                        </StackPanel>
                        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"
                            Text="Xbox library uses Microsoft Store license checks on your play history. Only titles with a confirmed Store entitlement are synced."/>
                    </StackPanel>
                </DockPanel>
            </TabItem>

            <TabItem Header="Sync Settings">
                <StackPanel Margin="12">
                    <TextBlock Text="Automatic Sync" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Margin="0,12,0,4" Text="Interval" Foreground="Gray" />
                    <ComboBox Width="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding SelectedInterval}" />

                    <CheckBox Margin="0,16,0,0"
                              Content="Sync on startup"
                              IsChecked="{Binding SyncOnStartup}" />

                    <CheckBox Margin="0,8,0,0"
                              Content="Confirm before manual sync"
                              IsChecked="{Binding ConfirmBeforeSync}" />

                    <TextBlock Margin="0,16,0,0"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Text="When enabled, the app syncs all enabled launchers automatically at the selected interval or when the app starts. Manual sync from the tray or Settings can ask for confirmation first." />
                </StackPanel>
            </TabItem>

            <TabItem Header="General">
                <StackPanel Margin="12">
                    <TextBlock Text="Application" FontWeight="SemiBold" FontSize="14" />
                    <CheckBox Margin="0,12,0,0"
                              Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows}" />
                    <CheckBox Margin="0,8,0,0"
                              Content="Show notifications"
                              IsChecked="{Binding ShowNotifications}" />

                    <TextBlock Margin="0,16,0,4" Text="Log level" Foreground="Gray" />
                    <ComboBox Width="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding LogLevelOptions}"
                              SelectedItem="{Binding SelectedLogLevel}" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Width="80"
                Content="Close"
                IsDefault="True"
                Click="CloseButton_Click" />
    </Grid>
</Window>
