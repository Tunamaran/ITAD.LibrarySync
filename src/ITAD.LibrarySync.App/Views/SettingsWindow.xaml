<Window x:Class="ITAD.LibrarySync.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ITAD Library Sync — Ayarlar"
        Height="540"
        Width="740"
        MinHeight="440"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="ITAD Bağlantısı">
                <StackPanel Margin="16">
                    <TextBlock Text="IsThereAnyDeal Hesabı" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                    
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bağlantı Durumu:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" Foreground="#0284C7"
                                           Text="{Binding ConnectionStatus, Mode=OneWay}" VerticalAlignment="Center" />
                            </Grid>
                            
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Kullanıcı Adı:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" Foreground="#0F172A"
                                           Text="{Binding AccountName, Mode=OneWay}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <Button Content="ITAD'a Bağlan"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="120"
                                Margin="0,0,8,0"
                                Command="{Binding ConnectCommand}" />
                        <Button Content="Bağlantıyı Kes"
                                Width="120"
                                Command="{Binding DisconnectCommand}" />
                        <Button Content="Şimdi Senkronize Et"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="150"
                                Margin="12,0,0,0"
                                Command="{Binding SyncNowCommand}" />
                    </StackPanel>

                    <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <TextBlock Foreground="#0369A1" TextWrapping="Wrap" FontSize="12" LineHeight="17">
                                <Run FontWeight="Bold" Text="Nasıl Çalışır?" /><LineBreak />
                                ITAD hesabınızı bağlayarak yerel kütüphanelerinizi otomatik aktarabilirsiniz. Oyun isimleri <Run FontWeight="SemiBold" Text="Akıllı Eşleştirme Motoru" /> tarafından otomatik düzeltilir ve eski hatalı kayıtlar profilinizden temizlenir.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Platformlar">
                <DockPanel Margin="4">
                    <!-- Platform Taraması İpucu Kartı -->
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock Foreground="#334155" TextWrapping="Wrap" FontSize="11.5" LineHeight="16">
                                <Run FontWeight="Bold" Text="Platform Taraması İpuçları:" /><LineBreak />
                                • <Run FontWeight="SemiBold" Text="Yerel Platformlar (Epic, Ubisoft, Battle.net, EA App):" /> Oyunlarınızın taranabilmesi için istemci uygulamasının bilgisayarınızda yüklü olması ve en az 1 kez çalıştırılmış olması yeterlidir. Ekstra hesap bağlama gerektirmez.<LineBreak />
                                • <Run FontWeight="SemiBold" Text="Xbox / Microsoft Store:" /> Kütüphanenizdeki ve Game Pass oyunlarının eksiksiz aktarılabilmesi için aşağıdan Xbox hesabınızı bağlamanız önerilir.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DataGrid DockPanel.Dock="Top"
                               Margin="0,0,0,12"
                               ItemsSource="{Binding LauncherStatuses}"
                               AutoGenerateColumns="False"
                               CanUserAddRows="False"
                               CanUserDeleteRows="False"
                               HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Platform"
                                                Binding="{Binding DisplayName}"
                                                Width="*"
                                                IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="Etkin"
                                                   Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                   Width="60" />
                            <DataGridTextColumn Header="Durum"
                                                Binding="{Binding DetectionStatus}"
                                                Width="110"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Son Senkronizasyon"
                                                Binding="{Binding LastSyncStats}"
                                                Width="*"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Sonuç"
                                                Binding="{Binding LastReadResult}"
                                                Width="*"
                                                IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Test" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Test Et"
                                                Padding="6,2"
                                                ToolTip="Bu platformun oyun kütüphanesini bilgisayarınızda veya hesabınızda hızlıca taranıp test edilmesini sağlar."
                                                Command="{Binding DataContext.TestReadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Detay" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Detaylar"
                                                Padding="6,2"
                                                ToolTip="Platformun tespit edildiği klasör yolunu, tarama metodunu ve tespit edilen tüm oyun listesini görüntüler."
                                                Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,0,4,8">
                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Xbox / Microsoft Store Hesabı" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding XboxConnectionStatus, Mode=OneWay}" Foreground="#64748B" Margin="0,2,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Xbox Bağla" Command="{Binding ConnectXboxCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Xbox Bağlantısını Kes" Command="{Binding DisconnectXboxCommand}"/>
                                    </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Senkronizasyon">
                <StackPanel Margin="16">
                    <TextBlock Text="Otomatik Senkronizasyon Ayarları" FontWeight="SemiBold" FontSize="15" />
                    
                    <!-- Bilgi Kartı -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock Foreground="#475569" TextWrapping="Wrap" FontSize="12" LineHeight="17">
                                <Run FontWeight="Bold" Text="Otomatik Senkronizasyon Rehberi:" /><LineBreak />
                                Seçtiğiniz zaman aralığında uygulama arka planda çalışarak kütüphanelerinizi güncel tutar. Bilgisayarınızı veya oyun istemcilerinizi açıp kapattığınızda yeni alınan oyunlar otomatik algılanır.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,4,0,6" Text="Senkronizasyon Sıklığı" Foreground="#64748B" FontSize="13" />
                    <ComboBox Width="240"
                              HorizontalAlignment="Left"
                              ToolTip="Arka planda oyun kütüphanelerinizin ne sıklıkla otomatik taranacağını ve ITAD'a gönderileceğini belirler."
                              ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding SelectedInterval}" />

                    <CheckBox Margin="0,18,0,0"
                              Content="Uygulama açılışında otomatik senkronize et"
                              ToolTip="Bilgisayar veya uygulama her başladığında kütüphanelerinizi anında senkronize eder."
                              IsChecked="{Binding SyncOnStartup}" />

                    <CheckBox Margin="0,10,0,0"
                              Content="Elle senkronizasyon öncesi onay iste"
                              ToolTip="Şimdi Senkronize Et butonuna bastığınızda aktarılacak oyun listesini onaylamanız için önizleme penceresi açar."
                              IsChecked="{Binding ConfirmBeforeSync}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="İstatistikler">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Kütüphane İstatistikleri ve Özet" FontWeight="SemiBold" FontSize="15" />
                        <UniformGrid Columns="3" Margin="0,16,0,16">
                            <Border Background="#1A0284C7" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Toplam Okunan Oyun" Foreground="#0369A1" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TotalSyncedGamesCount}" FontSize="26" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1A107C41" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="ITAD Eşleşme Oranı" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MatchRatePercentage, StringFormat=\{0\}%}" FontSize="26" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#1A5C2D91" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Aktif Platform" Foreground="#7E22CE" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding EnabledLaunchersCount}" FontSize="26" FontWeight="Bold" Foreground="#9333EA" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="Özel Eşleşme Kuralları (Custom Mappings)" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,8" />
                        <DataGrid ItemsSource="{Binding CustomMappings}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="180"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Platform" Binding="{Binding Launcher}" Width="95" />
                                <DataGridTextColumn Header="Oyun Adı" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="Yerel Mağaza ID" Binding="{Binding StoreId}" Width="130" />
                                <DataGridTextColumn Header="Hedef ITAD ID" Binding="{Binding MappedId}" Width="140" />
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Sil" Padding="6,2"
                                                    ToolTip="Bu özel eşleştirme kuralını siler."
                                                    Command="{Binding DataContext.RemoveCustomMappingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Eşleşmeyenler">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FEFCE8" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛠️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock Foreground="#854D0E" TextWrapping="Wrap" FontSize="11.5" LineHeight="16">
                                <Run FontWeight="Bold" Text="Eşleşmeyen Oyunları Manuel Eşleştirme Rehberi:" /><LineBreak />
                                Yerel platformlarınızda bulunan ancak ismi ITAD veritabanındaki resmi ismiyle birebir örtüşmeyen oyunlar burada listelenir. <Run FontWeight="SemiBold" Text="'Düzelt'" /> butonuna basarak doğru ITAD oyun linkini tanıtabilirsiniz.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="Listeyi Temizle"
                                Padding="12,4"
                                Margin="8,0,0,0"
                                ToolTip="Eşleşmeyen oyun kayıt geçmişini temizler."
                                Command="{Binding ClearUnmatchedTitlesCommand}" />
                        <Button DockPanel.Dock="Right"
                                Content="Yenile"
                                Padding="12,4"
                                ToolTip="Eşleşmeyen oyunlar listesini yeniden yükler."
                                Command="{Binding LoadUnmatchedTitlesCommand}" />
                        <TextBox Text="{Binding UnmatchedSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="6,4"
                                 ToolTip="Oyun adı veya Mağaza ID ara" />
                    </DockPanel>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding FilteredUnmatchedTitles}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Platform" Binding="{Binding Launcher}" Width="90" />
                            <DataGridTextColumn Header="Oyun Adı" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Mağaza ID" Binding="{Binding StoreId}" Width="120" />
                            <DataGridTextColumn Header="Neden" Binding="{Binding Reason}" Width="1.2*" />
                            <DataGridTextColumn Header="Tarih" Binding="{Binding DetectedAt, StringFormat=\{0:g\}}" Width="110" />
                            <DataGridTemplateColumn Header="Eylem" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Düzelt" Padding="6,2"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding DataContext.FixMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Loglar">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Foreground="#64748B" FontSize="12" VerticalAlignment="Center">
                                Uygulamanın kütüphane tarama, eşleştirme ve ITAD iletişim süreçlerine ait canlı günlüklerdir.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                Content="Log Klasörünü Aç"
                                Padding="12,4"
                                Margin="8,0,0,0"
                                ToolTip="Log dosyalarının saklandığı klasörü Windows Gezgini'nde açar."
                                Command="{Binding OpenLogFolderCommand}" />
                        <Button DockPanel.Dock="Right"
                                Content="Yenile"
                                Padding="12,4"
                                Margin="8,0,0,0"
                                ToolTip="Canlı log akışını yeniden yükler."
                                Command="{Binding RefreshLogsCommand}" />
                        <ComboBox DockPanel.Dock="Right"
                                  Width="100"
                                  Margin="8,0,0,0"
                                  ToolTip="Log seviyesine göre filtrele (ALL, INFO, ERROR)"
                                  ItemsSource="{Binding LogFilterOptions}"
                                  SelectedItem="{Binding SelectedLogFilter}" />
                        <TextBox Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="6,4"
                                 ToolTip="Log mesajlarında ara" />
                    </DockPanel>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding FilteredLogs}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zaman" Binding="{Binding Timestamp, StringFormat=\{0:HH:mm:ss\}}" Width="85" />
                            <DataGridTextColumn Header="Seviye" Binding="{Binding Level}" Width="75" />
                            <DataGridTextColumn Header="Mesaj Detayı" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Genel">
                <StackPanel Margin="16">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ITAD Library Sync" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="IsThereAnyDeal Oyun Kütüphanesi Senkronizasyon Aracı" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0284C7" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VersionInfo, Mode=OneWay, StringFormat=Sürüm {0}}" Foreground="White" FontWeight="Bold" FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding Lang[AppPreferencesHeader], Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                    <CheckBox Margin="0,12,0,0"
                              Content="{Binding Lang[StartWithWindowsLabel], Mode=OneWay}"
                              ToolTip="{Binding Lang[StartWithWindowsTooltip], Mode=OneWay}"
                              IsChecked="{Binding StartWithWindows}" />
                    <CheckBox Margin="0,10,0,0"
                              Content="{Binding Lang[ShowNotificationsLabel], Mode=OneWay}"
                              ToolTip="{Binding Lang[ShowNotificationsTooltip], Mode=OneWay}"
                              IsChecked="{Binding ShowNotifications}" />

                    <TextBlock Margin="0,14,0,6" Text="{Binding Lang[LanguageLabel], Mode=OneWay}" Foreground="#64748B" FontSize="13" />
                    <ComboBox Width="220"
                              HorizontalAlignment="Left"
                              ToolTip="{Binding Lang[LanguageTooltip], Mode=OneWay}"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}" />

                    <TextBlock Margin="0,14,0,6" Text="{Binding Lang[LogLevelLabel], Mode=OneWay}" Foreground="#64748B" FontSize="13" />
                    <ComboBox Width="220"
                              HorizontalAlignment="Left"
                              ToolTip="{Binding Lang[LogLevelTooltip], Mode=OneWay}"
                              ItemsSource="{Binding LogLevelOptions}"
                              SelectedItem="{Binding SelectedLogLevel}" />

                    <Separator Margin="0,20,0,16" Background="#E2E8F0" />

                    <TextBlock Text="Uygulama Güncellemeleri" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Margin="0,6,0,0" FontSize="13" Text="{Binding VersionInfo, Mode=OneWay, StringFormat=Mevcut Sürüm: {0}}" />
                    <TextBlock Margin="0,4,0,12" Foreground="#64748B" Text="{Binding UpdateStatusText, Mode=OneWay}" TextWrapping="Wrap" />

                    <ProgressBar Margin="0,0,0,12" Height="8" Value="{Binding DownloadProgress, Mode=OneWay}"
                                 Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Güncellemeleri Kontrol Et"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Command="{Binding CheckForUpdatesCommand}"
                                IsEnabled="{Binding CanCheckUpdates}" />
                        <Button Content="İndir ve Güncelle"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,6"
                                Command="{Binding DownloadAndApplyUpdateCommand}"
                                IsEnabled="{Binding CanCheckUpdates}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Width="90"
                Content="Kapat"
                IsDefault="True"
                Click="CloseButton_Click" />
    </Grid>
</Window>
