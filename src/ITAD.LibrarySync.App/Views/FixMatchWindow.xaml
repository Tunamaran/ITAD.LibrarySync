<Window x:Class="ITAD.LibrarySync.App.Views.FixMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eşleştirmeyi Düzelt (Fix Match)"
        Height="310"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Eşleştirmeyi Düzelt" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="#64748B" FontSize="12.5" TextWrapping="Wrap"
                   Text="ITAD kataloğunda otomatik bulunamayan bu oyun için doğru ITAD Game ID veya Mağaza ID değerini girin." />

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock FontSize="13" Text="{Binding Title, StringFormat=Oyun Adı: {0}}" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0" Text="{Binding StoreId, StringFormat=Yerel Mağaza ID: {0}}" />
                <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0" Text="{Binding LauncherName, StringFormat=Platform: {0}}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Hedef ITAD / Mağaza ID:" FontWeight="SemiBold" FontSize="13" />
            <TextBox Margin="0,6,0,0" Padding="8,6" Text="{Binding MappedId, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Örn: 018d937f-..." />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Kaydet" Style="{StaticResource PrimaryButtonStyle}" Width="95" Padding="8,5" Margin="0,0,8,0" IsDefault="True" Command="{Binding SaveCommand}" />
            <Button Content="İptal" Width="95" Padding="8,5" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
