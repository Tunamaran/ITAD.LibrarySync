<Window x:Class="ITAD.LibrarySync.App.Views.FixMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Lang[FixMatchTitle], Mode=OneWay}"
        SizeToContent="Height"
        Width="520"
        MinWidth="460"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Lang[FixMatchHeader], Mode=OneWay}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="#64748B" FontSize="12.5" TextWrapping="Wrap"
                       Text="{Binding Lang[FixMatchDesc], Mode=OneWay}" />

            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock FontSize="13" Text="{Binding Title, StringFormat={}{0}}" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0" Text="{Binding StoreId}" />
                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,2,0,0" Text="{Binding LauncherName}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="{Binding Lang[FixMatchTargetLabel], Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                <TextBox Margin="0,6,0,0" Padding="8,6" Text="{Binding MappedId, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding Lang[FixMatchTargetTooltip], Mode=OneWay}" />
                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#64748B" TextWrapping="Wrap">
                    <Run Text="{Binding Lang[FixMatchHelpPrefix], Mode=OneWay}" />
                    <Hyperlink NavigateUri="https://isthereanydeal.com/" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="isthereanydeal.com" />
                    </Hyperlink>
                    <Run Text="{Binding Lang[FixMatchHelpSuffix], Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{Binding Lang[FixMatchSave], Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="100" MinHeight="36" Padding="16,8" Margin="0,0,8,0" IsDefault="True" Command="{Binding SaveCommand}" />
                <Button Content="{Binding Lang[FixMatchCancel], Mode=OneWay}" MinWidth="100" MinHeight="36" Padding="16,8" IsCancel="True" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
