<Window x:Class="ITAD.LibrarySync.App.Views.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ITAD.LibrarySync.App.ViewModels"
        Title="ITAD Library Sync — Kurulum Sihirbazı"
        Height="490"
        Width="640"
        MinHeight="430"
        MinWidth="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="12" Foreground="#64748B">
                <Run Text="Adım " />
                <Run Text="{Binding StepNumber, Mode=OneWay}" />
                <Run Text=" / 4" />
            </TextBlock>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding StepTitle, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:WizardStep.Welcome}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock FontSize="14" TextWrapping="Wrap" LineHeight="20"
                           Text="ITAD Library Sync uygulamasına hoş geldiniz. Bu sihirbaz IsThereAnyDeal hesabınızı bağlamanıza, sisteminizdeki oyun platformlarını tespit etmeye ve ilk senkronizasyonu çalıştırmanıza yardımcı olacaktır." />
                <TextBlock Margin="0,16,0,0" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18"
                           Text="Uygulama sistem tepsisinde (System Tray) çalışır. Kurulum tamamlandıktan sonra Epic Games, Ubisoft Connect, Battle.net, EA App ve Xbox kütüphanelerinizi otomatik senkronize tutar." />
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:WizardStep.ItadOAuth}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Kütüphanelerinizi aktarabilmek için IsThereAnyDeal hesabınızı bağlayın."
                           TextWrapping="Wrap" FontSize="13.5" />
                
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Bağlantı Durumu:" Foreground="#64748B" FontSize="12.5" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"
                                   Text="{Binding ConnectionStatus, Mode=OneWay}" />
                        <TextBlock Text="Hesap:" Foreground="#64748B" FontSize="12.5" Margin="0,8,0,0" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"
                                   Text="{Binding AccountName, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Button Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="130"
                        Content="ITAD'a Bağlan"
                        Command="{Binding ConnectCommand}" />
                
                <TextBlock Margin="0,16,0,0"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Text="Tarayıcıda bir yetkilendirme penceresi açılacaktır. Devam etmeden önce ITAD hesabınızı bağlamalısınız." />
            </StackPanel>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:WizardStep.LauncherScan}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           Text="Yüklü platformlar taranıyor. Sonuçlar aşağıda görüntülenecektir." />
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding LauncherStatuses}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Platform"
                                            Binding="{Binding DisplayName}"
                                            Width="*"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Durum"
                                            Binding="{Binding DetectionStatus}"
                                            Width="120"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="Bulunan Oyunlar"
                                            Binding="{Binding LastReadResult}"
                                            Width="*"
                                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:WizardStep.FirstSync}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Kurulum tamamlandı! ITAD Library Sync sistem tepsisinde çalışacaktır."
                           TextWrapping="Wrap" FontSize="13.5" />
                <CheckBox Margin="0,20,0,0"
                          Content="Şimdi senkronize et"
                          IsChecked="{Binding RunSyncOnFinish}" />
                <TextBlock Margin="0,12,0,0"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Text="İşaretlendiğinde, kurulum biter bitmez tüm aktif platformlar ITAD Koleksiyon ve İstek Listesi profillerinize aktarılacaktır." />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    HorizontalAlignment="Left"
                    Width="90"
                    Content="Geri"
                    Command="{Binding GoBackCommand}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="95"
                        Margin="0,0,8,0"
                        Content="İleri"
                        Command="{Binding GoNextCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="95"
                        Content="Tamamla"
                        IsDefault="True"
                        Command="{Binding FinishCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
