<Window x:Class="ITAD.LibrarySync.App.Views.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ITAD.LibrarySync.App.ViewModels"
        Title="{Binding Lang[WizardTitle], Mode=OneWay}"
        Height="540"
        Width="680"
        MinHeight="460"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="12" Foreground="#64748B">
                <Run Text="{Binding Lang[WizardStepPrefix], Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding StepNumber, Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding Lang[WizardStepSuffix], Mode=OneWay}" />
            </TextBlock>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding StepTitle, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:WizardStep.Welcome}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock FontSize="14" TextWrapping="Wrap" LineHeight="20"
                           Text="{Binding Lang[WizardWelcomeBody], Mode=OneWay}" />
                <TextBlock Margin="0,16,0,0" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18"
                           Text="{Binding Lang[WizardWelcomeSubtext], Mode=OneWay}" />
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:WizardStep.ItadOAuth}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding Lang[WizardItadBody], Mode=OneWay}"
                           TextWrapping="Wrap" FontSize="13.5" />
                
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Lang[WizardItadStatusLabel], Mode=OneWay}" Foreground="#64748B" FontSize="12.5" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"
                                   Text="{Binding ConnectionStatus, Mode=OneWay}" />
                        <TextBlock Text="{Binding Lang[WizardItadAccountLabel], Mode=OneWay}" Foreground="#64748B" FontSize="12.5" Margin="0,8,0,0" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"
                                   Text="{Binding AccountName, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Button Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="130"
                        Content="{Binding Lang[WizardItadConnectBtn], Mode=OneWay}"
                        Command="{Binding ConnectCommand}" />
                
                <TextBlock Margin="0,16,0,0"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Text="{Binding Lang[WizardItadNote], Mode=OneWay}" />
            </StackPanel>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:WizardStep.LauncherScan}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           Text="{Binding Lang[WizardPlatformBody], Mode=OneWay}" />
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding LauncherStatuses}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding DataContext.Lang[WizardColPlatform], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                            Binding="{Binding DisplayName}"
                                            Width="*"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{Binding DataContext.Lang[WizardColStatus], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                            Binding="{Binding DetectionStatus}"
                                            Width="120"
                                            IsReadOnly="True" />
                        <DataGridTextColumn Header="{Binding DataContext.Lang[WizardColGames], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                            Binding="{Binding LastReadResult}"
                                            Width="*"
                                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="{x:Static vm:WizardStep.FirstSync}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding Lang[WizardReadyBody], Mode=OneWay}"
                           TextWrapping="Wrap" FontSize="13.5" />
                <CheckBox Margin="0,20,0,0"
                          Content="{Binding Lang[WizardSyncOnFinish], Mode=OneWay}"
                          IsChecked="{Binding RunSyncOnFinish}" />
                <TextBlock Margin="0,12,0,0"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Text="{Binding Lang[WizardSyncOnFinishNote], Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    HorizontalAlignment="Left"
                    Width="90"
                    Content="{Binding Lang[WizardBtnBack], Mode=OneWay}"
                    Command="{Binding GoBackCommand}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="95"
                        Margin="0,0,8,0"
                        Content="{Binding Lang[WizardBtnNext], Mode=OneWay}"
                        Command="{Binding GoNextCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="95"
                        Content="{Binding Lang[WizardBtnFinish], Mode=OneWay}"
                        IsDefault="True"
                        Command="{Binding FinishCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
