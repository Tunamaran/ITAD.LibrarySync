<Window x:Class="ITAD.LibrarySync.App.Views.StatDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ITAD.LibrarySync.App.Converters"
        xmlns:services="clr-namespace:ITAD.LibrarySync.App.Services"
        Title="{Binding WindowTitle}"
        Height="620"
        Width="820"
        MinHeight="480"
        MinWidth="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <converters:UnmatchedReasonConverter x:Key="UnmatchedReasonConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontWeight="SemiBold" FontSize="18" Text="{Binding HeaderTitle}" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,4,0,0" Foreground="#64748B" FontSize="13" Text="{Binding SummaryText}" />
        </StackPanel>

        <!-- Search Box (Visible for TotalGames and DuplicateGames modes) -->
        <TextBox Grid.Row="1"
                 Margin="0,0,0,12"
                 Padding="8,6"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{Binding Lang[StatSearchPlaceholder], Mode=OneWay}">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTotalGamesMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDuplicateGamesMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- 1. Total Games View -->
            <Grid Visibility="{Binding IsTotalGamesMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <DataGrid ItemsSource="{Binding FilteredTotalGames}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColGameTitle], Mode=OneWay}" Binding="{Binding Title}" Width="2*" />
                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColPlatform], Mode=OneWay}" Binding="{Binding DisplayPlatform}" Width="150" />
                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColLocalStoreId], Mode=OneWay}" Binding="{Binding StoreId}" Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 2. Match Rate Breakdown View -->
            <Grid Visibility="{Binding IsMatchRateMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[AutoMatchedLabel], Mode=OneWay}" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AutoMatchedCount}" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[CustomMappedLabel], Mode=OneWay}" Foreground="#0369A1" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CustomMappedCount}" FontSize="24" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FEFCE8" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[UnmatchedCountLabel], Mode=OneWay}" Foreground="#A16207" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding UnmatchedCount}" FontSize="24" FontWeight="Bold" Foreground="#CA8A04" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="{Binding Lang[UnmatchedGuideTitle], Mode=OneWay}" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,6" />
                    <DataGrid ItemsSource="{Binding UnmatchedList}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              MaxHeight="320"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColPlatform], Mode=OneWay}" Binding="{Binding Launcher}" Width="100" />
                            <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColGameTitle], Mode=OneWay}" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColLocalStoreId], Mode=OneWay}" Binding="{Binding StoreId}" Width="1.2*" />
                            <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColReason], Mode=OneWay}" Binding="{Binding ReasonCode, Converter={StaticResource UnmatchedReasonConverter}}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>

            <!-- 3. Active Platforms View -->
            <Grid Visibility="{Binding IsActivePlatformsMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <DataGrid ItemsSource="{Binding ActivePlatformsList}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColPlatform], Mode=OneWay}" Binding="{Binding DisplayName}" Width="180" />
                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColStatus], Mode=OneWay}" Binding="{Binding DetectionStatus}" Width="130" />
                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColScanPath], Mode=OneWay}" Binding="{Binding LastReadResult}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 4. Duplicate Games View -->
            <Grid Visibility="{Binding IsDuplicateGamesMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <DataGrid ItemsSource="{Binding FilteredDuplicateGames}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColGameTitle], Mode=OneWay}" Binding="{Binding Title}" Width="2*" />
                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColOwnedPlatforms], Mode=OneWay}" Binding="{Binding PlatformsList}" Width="220" />
                        <DataGridTextColumn Header="{Binding Source={x:Static services:LanguageManager.Instance}, Path=[ColLocalStoreId], Mode=OneWay}" Binding="{Binding StoreIdsList}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Close Button -->
        <Button Grid.Row="3"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                MinWidth="100" MinHeight="36" Padding="16,8"
                Content="{Binding Lang[BtnClose], Mode=OneWay}"
                IsDefault="True"
                IsCancel="True"
                AutomationProperties.Name="Close details window"
                Click="CloseButton_Click" />
    </Grid>
</Window>
