<Window x:Class="ITAD.LibrarySync.App.Views.LibraryPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding LauncherName, StringFormat={}{0} — Kütüphane Önizlemesi}"
        Height="580"
        Width="780"
        MinHeight="440"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontWeight="SemiBold" FontSize="16" Text="{Binding LauncherName}" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="#64748B"
                       Text="{Binding Summary, StringFormat=Özet: {0}}" />

            <!-- Tanılama ve Sürücü Bilgi Kartı -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#475569" Text="{Binding ResolvedPath, StringFormat=📌 Tespit Edilen Yol: {0}}" TextWrapping="Wrap" />
                    <TextBlock FontSize="12" Foreground="#475569" Margin="0,3,0,0" Text="{Binding DetectionSource, StringFormat=🔍 Tespit Metodu: {0}}" />
                </StackPanel>
            </Border>
            <TextBlock Margin="0,8,0,0"
                       Foreground="DarkOrange"
                       TextWrapping="Wrap"
                       Text="{Binding PreviewWarning}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasWarning}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Expander Margin="0,8,0,0"
                      Header="{Binding DetailsHeader}"
                      IsExpanded="False">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <ListBox ItemsSource="{Binding DetailLines}"
                         MaxHeight="160"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Expander>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,4"
                   Foreground="#64748B"
                   FontSize="12.5"
                   Text="Arama / Filtreleme" />

        <TextBox Grid.Row="2"
                 Margin="0,0,0,12"
                 Padding="8,6"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Oyun adı veya mağaza ID ara" />

        <TabControl Grid.Row="3">
            <TabItem Header="{Binding OwnedCount, StringFormat=Sahip Olunanlar ({0})}">
                <DataGrid ItemsSource="{Binding OwnedGames}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Oyun Adı" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Mağaza ID" Binding="{Binding StoreId}" Width="200" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{Binding WishlistCount, StringFormat=İstek Listesi ({0})}">
                <DataGrid ItemsSource="{Binding WishlistGames}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Oyun Adı" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Mağaza ID" Binding="{Binding StoreId}" Width="200" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="4"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                Width="90"
                Content="Kapat"
                IsDefault="True"
                Click="CloseButton_Click" />
    </Grid>
</Window>
